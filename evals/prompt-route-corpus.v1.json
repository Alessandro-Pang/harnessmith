  "cases": [
    {
      "id": "zh-review",
      "categories": ["zh", "action", "false-negative-guard"],
      "query": "请评审这个变更。",
      "expected": { "status": "matched", "top1": "review", "topics": [], "forbiddenPlaybooks": [] }
    },
    {
      "id": "en-diagnose-negated-change",
      "categories": ["en", "negation", "false-positive-guard"],
