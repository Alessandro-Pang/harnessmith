      "oracle": {
        "kind": "memory-state",
        "command": "harness memory check global --json",
        "operation": "none"
      },
      "dependencyPaths": [
        "packages/harness/src/lib/memory/memory-candidate-discovery.ts",
        "packages/harness/src/commands/memory/memory-profile.ts"
      ],
      "operation": "none",
      "stateContract": {
        "kind": "no-write",
        "deterministic": true
      }
    },
    {
