{
  "schemaVersion": 1,
  "scenarios": [
    {
      "id": "explicit-profile",
      "description": "Capture an explicit cross-task preference in the canonical global profile.",
      "scope": "global-profile",
      "expectedDecision": "write",
      "expectedAction": "created",
      "evaluationStatus": "active",
      "promptVariants": [
        "以后代码评审默认先给结论，再列风险和证据。",
        "For future reviews, start with the conclusion, then list risks and evidence."
      ],
      "setup": {
        "globalMemory": "empty",
        "projectMemory": "empty",
        "taskCount": 1
      },
      "pass": [
        "profile.md contains one normalized explicit/high record",
        "the writer returns created or updated"
      ],
      "forbidden": [
        "project facts are not written to global profile",
        "the final reply alone is not used as write evidence"
      ],
      "oracle": {
        "kind": "memory-state",
        "command": "harness memory check global --json",
        "operation": "typed-operation"
      },
      "dependencyPaths": [
        "template/agent-harness/docs/standards/user-profile-memory.md",
        "packages/harness/src/commands/memory/memory-profile.ts"
      ],
      "operation": "reconcile-profile",
      "stateContract": {
        "kind": "profile-create",
        "deterministic": true,
        "key": "communication.review-format"
      }
    },
    {
      "id": "repeated-observation",
      "description": "Repeated behavior without an explicit durable request remains a candidate.",
      "scope": "global-profile",
      "expectedDecision": "proposed",
