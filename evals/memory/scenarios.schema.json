{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harnessmith:memory-eval-scenarios:v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scenarios"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "scenarios": {
      "type": "array",
      "minItems": 10,
      "maxItems": 64,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/scenario" }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 128 },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "scope", "expectedDecision", "expectedAction", "evaluationStatus", "operation", "promptVariants", "setup", "pass", "forbidden", "oracle", "dependencyPaths"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "description": { "$ref": "#/$defs/text" },
        "scope": { "enum": ["global-profile", "project-memory", "cross-session", "safety"] },
        "expectedDecision": { "enum": ["write", "no-write", "proposed", "blocked"] },
        "expectedAction": { "enum": ["created", "updated", "unchanged", "no-change", "proposed", "blocked", "none"] },
        "evaluationStatus": { "enum": ["active", "inconclusive"] },
        "operation": { "enum": ["none", "search", "capture-input", "close-input", "capture-finding", "capture-experience", "reconcile-profile", "forget-profile", "profile-autopilot", "handoff", "close-handoff", "supersede", "archive", "maintain", "repair", "migrate", "curate", "curation-apply"] },
        "stateContract": { "type": "object", "additionalProperties": false, "required": ["kind"], "properties": { "kind": { "enum": ["profile-create", "profile-update", "profile-forget", "profile-control", "project-input-create", "project-input-idempotent", "no-write", "typed-operation"] }, "key": { "$ref": "#/$defs/text" }, "operation": { "$ref": "#/$defs/text" }, "expectedScopes": { "type": "array", "uniqueItems": true, "items": { "enum": ["global", "project"] } }, "deterministic": { "type": "boolean" } } },
        "evaluationReason": { "$ref": "#/$defs/text" },
        "promptVariants": { "type": "array", "minItems": 2, "maxItems": 16, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } },
        "setup": {
          "type": "object",
          "additionalProperties": false,
          "required": ["globalMemory", "projectMemory", "taskCount"],
          "properties": {
            "globalMemory": { "enum": ["empty", "seeded"] },
            "projectMemory": { "enum": ["empty", "seeded"] },
            "taskCount": { "type": "integer", "minimum": 1, "maximum": 8 }
          }
        },
        "pass": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/text" } },
        "forbidden": { "type": "array", "minItems": 1, "maxItems": 16, "items": { "$ref": "#/$defs/text" } },
        "oracle": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "command", "operation"],
          "properties": {
            "kind": { "enum": ["filesystem", "memory-state", "cross-session"] },
            "operation": { "enum": ["none", "typed-operation"] },
            "command": { "$ref": "#/$defs/text" }
          }
        },
        "dependencyPaths": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/$defs/text" } }
      },
      "allOf": [
        {
          "if": { "properties": { "evaluationStatus": { "const": "inconclusive" } } },
          "then": {
            "required": ["evaluationReason"],
            "properties": { "evaluationReason": { "$ref": "#/$defs/text" } }
          }
        }
      ]
    }
  }
}
