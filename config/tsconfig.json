{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "../packages/cli/src/**/*.ts",
    "../packages/harness/src/**/*.ts",
    "../scripts/**/*.ts",
    "../evals/**/*.ts",
    "*.config.ts"
  ],
  "exclude": ["../dist", "../template/agent-harness/dist", "../node_modules"]
}
