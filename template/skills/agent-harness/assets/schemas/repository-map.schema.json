{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harnessmith.dev/schemas/repository-map.schema.json",
  "title": "Personal Repository Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "repositories", "relations"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "repositories": {
      "type": "array",
      "maxItems": 200,
      "items": { "$ref": "#/$defs/repository" }
    },
    "relations": {
      "type": "array",
      "maxItems": 1000,
      "items": { "$ref": "#/$defs/relation" }
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?![A-Za-z]:)(?!.*(^|/)\\.\\.(/|$)).+$"
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "description", "checkout", "owns", "aliases", "remotes", "sources"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,79}$"
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 240 },
        "checkout": { "$ref": "#/$defs/relativePath" },
        "owns": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "aliases": {
          "type": "array",
          "maxItems": 12,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "remotes": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 500 }
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/relativePath" }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "side", "path"],
      "properties": {
        "repository": { "type": "string", "minLength": 1, "maxLength": 80 },
        "side": { "enum": ["provider", "consumer", "contract"] },
        "path": { "$ref": "#/$defs/relativePath" }
      }
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "provider", "contract", "consumer", "evidence"],
      "properties": {
        "type": {
          "enum": ["package", "http-api", "rpc", "event", "artifact", "proxy", "migration", "extension"]
        },
        "provider": { "type": "string", "minLength": 1, "maxLength": 80 },
        "contract": { "type": "string", "minLength": 1, "maxLength": 240 },
        "consumer": { "type": "string", "minLength": 1, "maxLength": 80 },
        "evidence": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": { "$ref": "#/$defs/evidence" }
        }
      }
    }
  }
}
