{
  "name": "harnessmith",
  "version": "0.5.0",
  "description": "Forge and safely manage an opinionated, portable personal agent harness.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alessandro-Pang/harnessmith.git"
  },
  "homepage": "https://github.com/Alessandro-Pang/harnessmith#readme",
  "bugs": "https://github.com/Alessandro-Pang/harnessmith/issues",
  "author": "zi.yang <pcy1314@163.com> (https://github.com/Alessandro-Pang)",
  "type": "module",
  "bin": {
    "harnessmith": "bin/harnessmith.mjs"
  },
  "files": [
    "bin",
    "dist",
    "template/AGENTS.md",
    "template/agent-harness/bin",
    "template/agent-harness/dist",
    "template/agent-harness/docs",
    "template/agent-harness/manifest.json",
    "template/agent-harness/schemas",
    "template/agent-harness/templates",
    "evals/README.md",
    "evals/scenarios.json",
    "evals/scenarios.schema.json",
    "evals/run.schema.json",
    "evals/run.example.json",
    "docs/architecture.md",
    "README.md",
    "README.en.md",
    "RELEASING.md",
    "CONTRIBUTING.md",
    "SECURITY.md",
    "CHANGELOG.md",
    "llms.txt",
    "LICENSE"
  ],
  "scripts": {
    "prepare": "node .husky/install.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "lint:md": "markdownlint-cli2",
    "format": "biome format --write",
    "format:check": "biome format",
    "commitlint": "commitlint",
    "build": "pnpm run typecheck && tsup",
    "check": "pnpm run lint && pnpm run format:check && pnpm run lint:md && pnpm run typecheck && pnpm run quality:dead-code && pnpm run quality:secrets",
    "check:docs": "node --import tsx scripts/preflight.ts docs",
    "check:cli": "pnpm run build && node --import tsx scripts/preflight.ts cli",
    "preflight:staged": "lint-staged && pnpm run typecheck && pnpm run check:docs",
    "preflight": "pnpm run check && pnpm run build && node --import tsx scripts/preflight.ts all && pnpm run test:unit",
    "pretest": "pnpm run build",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:harness": "vitest run template/agent-harness/src/__tests__",
    "test:watch": "vitest",
    "eval:check": "vitest run evals/__tests__",
    "eval:fingerprint": "node --import tsx scripts/eval-gate.ts fingerprint --json",
    "eval:validate": "node --import tsx scripts/eval-gate.ts validate",
    "eval:gate": "node --import tsx scripts/eval-gate.ts gate",
    "sbom": "node --import tsx scripts/sbom.ts generate",
    "sbom:check": "node --import tsx scripts/sbom.ts check",
    "pretest:coverage": "pnpm run build",
    "test:coverage": "pnpm run test:coverage:unit && pnpm run test:scripts-coverage",
    "test:coverage:unit": "vitest run --coverage",
    "test:scripts-coverage": "pnpm run test:scripts-coverage:preflight && pnpm run test:scripts-coverage:eval",
    "test:scripts-coverage:preflight": "c8 -c c8.scripts.json --reporter=json node --import tsx scripts/preflight.ts all",
    "test:scripts-coverage:eval": "c8 -c c8.scripts.json --reporter=text --clean=false --check-coverage --lines 90 --functions 95 --branches 70 --statements 90 pnpm exec vitest run evals/__tests__ src/__tests__/adapters-git.test.ts src/__tests__/preflight-docs.test.ts",
    "quality:dead-code": "knip --reporter compact",
    "quality:secrets": "secretlint --no-color \"src/**/*\" \"scripts/**/*\" \"template/**/*\" \"evals/**/*\" \"docs/**/*\" \".github/**/*\" \".husky/**/*\" \"*.md\" \"*.txt\" \"*.json\" \"*.yaml\" \"*.yml\" \"*.ts\" \"*.mjs\"",
    "release:check": "pnpm run preflight && pnpm run test:coverage && pnpm run sbom:check && pnpm run eval:gate",
    "release:publish": "node --import tsx scripts/release-publish.ts",
    "prepack": "pnpm run preflight",
    "prepublishOnly": "pnpm run release:check"
  },
  "engines": {
    "node": ">=24.12.0"
  },
  "packageManager": "pnpm@10.13.0",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "coding-agent",
    "codex",
    "cursor",
    "claude-code",
    "agents-md",
    "harness",
    "harnessmith"
  ],
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "1.7.0",
    "commander": "15.0.0",
    "execa": "10.0.1",
    "fdir": "6.5.0",
    "picocolors": "1.1.1",
    "proper-lockfile": "4.1.2",
    "which-command": "0.1.0",
    "write-file-atomic": "7.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@secretlint/secretlint-rule-preset-recommend": "13.0.4",
    "@types/node": "24.13.3",
    "@types/proper-lockfile": "4.1.4",
    "@types/write-file-atomic": "4.0.3",
    "@vitest/coverage-v8": "4.1.11",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "c8": "12.0.0",
    "fast-check": "4.9.0",
    "husky": "9.1.7",
    "knip": "6.32.2",
    "lint-staged": "17.3.0",
    "markdownlint-cli2": "0.23.2",
    "mdast-util-from-markdown": "2.0.3",
    "secretlint": "13.0.4",
    "tar": "7.5.22",
    "tsup": "8.5.1",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "unist-util-visit": "5.1.0",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
